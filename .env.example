# Required for local API usage. Replace placeholders with your own values.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/pet-odyssey
JWT_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CLIENT_ORIGIN=http://localhost:4200

# Optional: set only when running behind a trusted reverse proxy.
# TRUST_PROXY_HOPS=1

# Optional deployment metadata.
# NODE_ENV=development
# VERCEL=1
# VERCEL_ENV=development

# Optional Cloudinary config. Use CLOUDINARY_URL or all three individual values.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
